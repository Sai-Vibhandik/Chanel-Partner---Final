# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/database_name

# JWT Configuration
# IMPORTANT: Generate a cryptographically strong secret (minimum 256 bits)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_strong_random_jwt_secret_here
JWT_EXPIRES_IN=7d
# Access token - short lived (recommended: 15 minutes)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token - long lived (recommended: 7 days)
JWT_REFRESH_EXPIRES_IN=7d
# Refresh token secret (optional - derived from JWT_SECRET if not set)
# JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Configuration (Optional - not implemented)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Stripe Configuration (Optional - not implemented)
STRIPE_SECRET_KEY=your_stripe_secret_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Channel Partner Portal

# Rate Limiting Configuration
# General API rate limit (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Authentication rate limits (stricter)
AUTH_RATE_LIMIT_MAX=5
REGISTRATION_RATE_LIMIT_MAX=3
REGISTRATION_RATE_LIMIT_WINDOW_MS=3600000

# File Upload
MAX_FILE_SIZE=20971520

# Security
# Set to 'production' in production environment
NODE_ENV=development